    "vulnerabilities": [
        {
            "cve": "CVE-2026-109618",
            "flags": [
                {
                    "label": "component_not_present",
                    "product_ids": [
                        "isduba-all-versions"
                    ]
                }
            ],
            "notes": [
                {
                    "category": "description",
                    "text": "PHP uses longjmp() for out-of-memory (OOM) errors to exit the current context and abort handling of the request. Some contexts may not properly account for this scenario and leave request memory in an uninitialized state before performing an allocation. The subsequent request cleanup procedure may read or branch on this memory. Multiple OOM strategies can consistently trigger this condition and lead to remote code execution (RCE).",
                    "title": "CVE description"
                }
            ],
            "product_status": {
                "known_not_affected": [
                    "isduba-all-versions"
                ]
            },
            "title": "PHP RCE via OOM corruption"
        },
        {
            "cve": "CVE-2026-109619",
            "flags": [
                {
                    "label": "component_not_present",
                    "product_ids": [
                        "isduba-all-versions"
                    ]
                }
            ],
            "notes": [
                {
                    "category": "description",
                    "text": "PHP has various global state that temporarily points into request memory. In some scenarios, global state may not be correctly reset, or may be repopulated after being reset. The global state may then refer to request memory even after it has been freed. Subsequent requests may read or branch on this stale state before it is fully initialized. Multiple strategies can trigger this condition and produce remote code execution (RCE).",
                    "title": "CVE description"
                }
            ],
            "product_status": {
                "known_not_affected": [
                    "isduba-all-versions"
                ]
            },
            "title": "PHP RCE via stale global state"
        }
    ]
